// Daten sicher aus dem Context laden
const series = context.panel.data.series;
if (!series || series.length < 2) return {};


// 1. Außentemperatur (X-Achse) finden
// Wir suchen nach 'Umgebung' im Namen ODER nach der Query-ID 'I'
const outdoorSeries = series.find(s => 
  s.name === 'Umgebung' || 
  s.refId === 'I' || 
  (s.fields && s.fields.some(f => f.name === 'Umgebung'))
);

if (!outdoorSeries) {
  // Debug-Anzeige: Was sieht das Skript eigentlich?
  const availableNames = series.map(s => s.name).join(', ');
  return { 
    title: { 
      text: `Fehler: 'Umgebung' nicht gefunden. Verfügbar: ${availableNames}`, 
      left: 'center',
      textStyle: { fontSize: 12, color: 'red' }
    } 
  };
}

// X-Werte extrahieren
const xField = outdoorSeries.fields.find(f => f.type === 'number');
const xValues = xField ? xField.values : [];

// 2. Alle anderen Temperaturen (Y-Werte) mappen
const plotData = series
  .filter(s => s !== outdoorSeries) // Alles außer der Umgebungstemperatur
  .map(s => {
    const yField = s.fields.find(f => f.type === 'number');
    if (!yField) return null;
    const yValues = yField.values;

    // Paare bilden [X, Y] -> [Umgebung, Vorlauf/Rücklauf]
    const pairs = [];
    for (let i = 0; i < xValues.length; i++) {
        if (xValues[i] !== null && yValues[i] !== null) {
            pairs.push([xValues[i], yValues[i]]);
        }
    }
    
    return {
      name: s.name,
      type: 'scatter',
      symbolSize: 6,
      data: pairs,
      opacity: 0.7,
      large: true
    };
  }).filter(s => s !== null);

return {
  title: { text: 'Heizkurve: Vor-/Rücklauf über Außentemperatur', left: 'center', textStyle: { color: '#ccc' } },
  tooltip: { 
    trigger: 'item',
    formatter: (params) => `${params.seriesName}<br/>Außen: ${params.value[0]}°C<br/>System: ${params.value[1]}°C`
  },
  legend: { bottom: '5%', textStyle: { color: '#ccc' } },
  grid: { top: '15%', bottom: '20%', left: '10%', right: '10%' },
  xAxis: { 
    name: 'Außentemperatur [°C]', 
    type: 'value', 
    scale: true,
    nameLocation: 'middle',
    nameGap: 30
  },
  yAxis: { 
    name: 'Systemtemperatur [°C]', 
    type: 'value', 
    scale: true 
  },
  series: plotData
};
