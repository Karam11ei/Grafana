// Prüfen ob Daten da sind
if (!data || !data.series || data.series.length < 2) {
    return { title: { text: "Warte auf Daten...", left: 'center' } };
}

// 1. Felder extrahieren
const seriesA = data.series[0]; // Bezug
const seriesB = data.series[1]; // Einspeisung

const time = seriesA.fields.find(f => f.type === 'time')?.values;
const valuesA = seriesA.fields.find(f => f.type === 'number')?.values; 
const valuesB = seriesB.fields.find(f => f.type === 'number')?.values;

if (!time || !valuesA || !valuesB) return { title: { text: "Feld-Fehler" } };

// 2. Variablen für Simulation
const capacity = (context.replaceVariables('${batt_size}') || 5) * 1; // Kapazität in kWh
let currentSoC = 0; // Start bei 0 oder einem festen Wert

const simBezug = [];
const simEinspeisung = [];
const socP = [];

// 3. Simulation
// Da non_negative_difference im Query ist, sind valuesA[i] bereits die Differenzwerte!
for (let i = 0; i < time.length; i++) {
    let deltaB = valuesA[i] || 0; // Was wir aus dem Netz ziehen müssten
    let deltaE = valuesB[i] || 0; // Was wir einspeisen würden

    // A: Laden - Wenn Überschuss da ist
    if (deltaE > 0) {
        let charge = Math.min(deltaE, capacity - currentSoC);
        currentSoC += charge;
        deltaE -= charge; // Rest der noch ins Netz geht
    }

    // B: Entladen - Wenn Bedarf da ist
    if (deltaB > 0) {
        let discharge = Math.min(deltaB, currentSoC);
        currentSoC -= discharge;
        deltaB -= discharge; // Rest der noch vom Netz kommt
    }

    simBezug.push([time[i], deltaB.toFixed(3)]);
    simEinspeisung.push([time[i], deltaE.toFixed(3)]);
    socP.push([time[i], ((currentSoC / capacity) * 100).toFixed(1)]);
}

// 4. ECharts Konfiguration
return {
    tooltip: { trigger: 'axis' },
    legend: { data: ['Netz-Bezug (sim)', 'Einspeisung (sim)', 'SoC %'] },
    grid: { bottom: '10%' },
    xAxis: { type: 'time' },
    yAxis: [
        { type: 'value', name: 'kWh' },
        { type: 'value', name: '%', max: 100, position: 'right' }
    ],
    series: [
        { name: 'Netz-Bezug (sim)', type: 'bar', stack: 'total', data: simBezug, color: '#ef5350' },
        { name: 'Einspeisung (sim)', type: 'bar', stack: 'total', data: simEinspeisung, color: '#66bb6a' },
        { name: 'SoC %', type: 'line', yAxisIndex: 1, data: socP, color: '#ffee58', smooth: true, symbol: 'none' }
    ]
};
