// Sicherstellen, dass Daten da sind
if (!data.series || data.series.length < 2) return { title: { text: "No Data" } };

// --- METHODE AUS DEINEM BILD (Aktualisiert) ---
const seriesA = data.series[0];
const seriesB = data.series[1];

// Wir nutzen direkt .values statt .values.buffer
const time = seriesA.fields.find(f => f.type === 'time').values;
const valA = seriesA.fields.find(f => f.type === 'number').values; // Zählerstand Bezug
const valB = seriesB.fields.find(f => f.type === 'number').values; // Zählerstand Einspeisung

const capacity = (context.replaceVariables('${batt_size}') || 5) * 1000; 
let currentSoC = 0;

const simBezug = [];
const simEinspeisung = [];
const socP = [];

// Schleife startet bei 1, um die Differenz zum vorherigen Punkt (i-1) zu bilden
for (let i = 1; i < time.length; i++) {
    // Schritt 1: Realen Verbrauch/Überschuss aus Zählerstand berechnen
    let deltaB = Math.max(0, valA[i] - valA[i-1]); 
    let deltaE = Math.max(0, valB[i] - valB[i-1]);

    // Schritt 2: Simulation (Logik Solaranlage-Ratgeber)
    // Überschuss in Batterie laden
    if (deltaE > 0) {
        let charge = Math.min(deltaE, capacity - currentSoC);
        currentSoC += charge;
        deltaE -= charge;
    }

    // Nachtbedarf aus Batterie decken
    if (deltaB > 0) {
        let discharge = Math.min(deltaB, currentSoC);
        currentSoC -= discharge;
        deltaB -= discharge;
    }

    simBezug.push([time[i], deltaB]);
    simEinspeisung.push([time[i], deltaE]);
    socP.push([time[i], (currentSoC / capacity) * 100]);
}

// --- VISUALISIERUNG ---
return {
    tooltip: { trigger: 'axis' },
    legend: { data: ['Rest-Bezug', 'Rest-Einspeisung', 'SoC %'] },
    xAxis: { type: 'time' },
    yAxis: [{ type: 'value', name: 'kWh' }, { type: 'value', name: '%', max: 100 }],
    series: [
        { name: 'Rest-Bezug', type: 'bar', stack: 'a', data: simBezug, color: 'red' },
        { name: 'Rest-Einspeisung', type: 'bar', stack: 'a', data: simEinspeisung, color: 'green' },
        { name: 'SoC %', type: 'line', yAxisIndex: 1, data: socP, color: 'yellow' }
    ]
};
