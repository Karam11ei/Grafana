const payload = {};

// 1. E-Mail/Eingabefelder auslesen (Dein Teil war gut!)
elements.forEach((element) => {
  if (element.value !== undefined) {
    payload[element.id] = element.value;
  }
});

// Funktion, um den letzten Wert einer Query sicher zu finden
const getValueByRef = (refId) => {
  const series = data.series.find(s => s.refId === refId);
  if (!series) return null;
  
  // Suche das Feld, das Zahlen enthält (meistens das zweite Feld nach der Zeit)
  const valueField = series.fields.find(f => f.type === 'number') || series.fields[0];
  
  // Nimm den allerletzten Wert aus diesem Feld
  return valueField.values.get(valueField.values.length - 1);
};

// 2. Werte sicher zuweisen
payload.strom_evu = getValueByRef('A');
payload.pv_erzeugung = getValueByRef('B');
payload.gas_verbrauch = getValueByRef('C');
payload.gesamt_verbrauch = getValueByRef('D');

// 3. Zeitraum (Verwende das Standard-Format für APIs)
payload.zeit_von = window.location.search.includes('from') ? data.timeRange.from.toISOString() : null;
payload.zeit_bis = data.timeRange.to.toISOString();

return payload;
