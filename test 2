// Daten aus Grafana extrahieren
const series = data.series.map((s) => {
  const sTime = s.fields.find((f) => f.type === 'time').values;
  const sValue = s.fields.find((f) => f.name === 'value' || f.type === 'number').values;

  return {
    name: s.refId || s.name,
    type: 'line',
    sampling: 'lttb', // Optimiert die Darstellung bei vielen Datenpunkten
    smooth: true,     // Macht die Kurven weicher
    symbol: 'none',   // Entfernt die Punkte auf der Linie für einen saubereren Look
    lineStyle: {
      width: 2
    },
    areaStyle: {
      opacity: 0.2    // Dezente Füllung unter der Linie
    },
    data: sValue.map((val, i) => [sTime[i], val])
  };
});

return {
  tooltip: {
    trigger: 'axis',
    confine: true
  },
  legend: {
    show: true,
    bottom: 0
  },
  grid: {
    left: '3%',
    right: '4%',
    bottom: '10%',
    containLabel: true
  },
  xAxis: {
    type: 'time',
    boundaryGap: false
  },
  yAxis: {
    type: 'value',
    splitLine: {
      show: true,
      lineStyle: {
        type: 'dashed'
      }
    }
  },
  series: series
};
