// Daten aus dem Payload holen
const empfaenger = msg.payload.Empfeanger;
const strom = msg.payload.Stromsumme || 0;
const gas = msg.payload.GasSumme || 0;
const datum = new Date().toLocaleDateString('de-DE');

// Das HTML Layout der Rechnung
msg.payload = `
<html>
<head>
    <style>
        body { font-family: Arial; padding: 40px; }
        .header { text-align: right; color: #555; }
        h1 { color: #2c3e50; border-bottom: 2px solid #2c3e50; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 12px; text-align: left; }
        th { background-color: #f2f2f2; }
        .total { font-weight: bold; font-size: 1.2em; }
    </style>
</head>
<body>
    <div class="header">Datum: ${datum}</div>
    <h1>Energieabrechnung</h1>
    <p>Empfänger: <strong>${empfaenger}</strong></p>
    
    <table>
        <tr><th>Position</th><th>Verbrauch / Wert</th></tr>
        <tr><td>Stromverbrauch Bezug</td><td>${strom} kWh</td></tr>
        <tr><td>Gasverbrauch Halle</td><td>${gas} m³</td></tr>
    </table>
    
    <p>Vielen Dank für die Nutzung!</p>
</body>
</html>
`;

// Dateiname für das PDF festlegen
msg.filename = "rechnung_" + Date.now() + ".pdf";
return msg;
