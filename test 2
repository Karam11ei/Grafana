SELECT DIFFERENCE(LAST("value")) AS "difference"
FROM "home_assistant"."autogen"."m³"
WHERE $timeFilter
AND "entity_id" = 's02_verbrauch_zahlerstand_m3'
GROUP BY time(1h) FILL(0)



const series = data.series[0];
if (!series) return {};

const timeField = series.fields.find((f) => f.type === 'time').values;
const valueField = series.fields.find((f) => f.name === 'difference').values;

const hours = ['12a', '1a', '2a', '3a', '4a', '5a', '6a', '7a', '8a', '9a', '10a', '11a', '12p', '1p', '2p', '3p', '4p', '5p', '6p', '7p', '8p', '9p', '10p', '11p'];
const days = ['Sonntag', 'Samstag', 'Freitag', 'Donnerstag', 'Mittwoch', 'Dienstag', 'Montag'];

// Daten in [Stunde, Tag, Wert] Format bringen
const heatmapData = [];
for (let i = 0; i < timeField.length; i++) {
  const date = new Date(timeField[i]);
  const hour = date.getHours();
  // day: 0=So, 1=Mo... wir drehen es für die Anzeige um
  const day = date.getDay(); 
  const displayDay = 6 - ((day + 6) % 7); // Korrektur damit Montag unten ist (oder oben je nach Wunsch)
  
  heatmapData.push([hour, displayDay, valueField[i] || 0]);
}

return {
  tooltip: { position: 'top' },
  grid: { height: '70%', top: '10%' },
  xAxis: { type: 'category', data: hours, splitArea: { show: true } },
  yAxis: { type: 'category', data: days, splitArea: { show: true } },
  visualMap: {
    min: 0,
    max: 5, // Hier anpassen: Was ist ein hoher Stundenverbrauch?
    calculable: true,
    orient: 'horizontal',
    left: 'center',
    bottom: '5%',
    inRange: { color: ['#313695', '#4575b4', '#abd9e9', '#ffffbf', '#fee090', '#f46d43', '#d73027', '#a50026'] }
  },
  series: [{
    name: 'Gasverbrauch',
    type: 'heatmap',
    data: heatmapData,
    label: { show: false },
    emphasis: { itemStyle: { shadowBlur: 10, shadowColor: 'rgba(0, 0, 0, 0.5)' } }
  }]
};

























