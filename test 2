const payload = {};

// 1. Empfänger auslesen
context.panel.elements.forEach((element) => {
  if (element.value) payload[element.id] = element.value;
});

// 2. Daten über das interne Panel-Objekt suchen
try {
  // Wir schauen direkt in das Datenobjekt, das Grafana an das Panel reicht
  const series = context.grafana.data.series;
  
  if (series && series.length > 0) {
    payload.strom_evu = series[0].fields[1].state.calcs.last;
    payload.pv_erzeugung = series[1].fields[1].state.calcs.last;
    payload.gas_verbrauch = series[2].fields[1].state.calcs.last;
  }
} catch (e) {
  // Falls das auch nicht geht, schicken wir die Struktur zur Analyse mit
  payload.debug_info = "Series length: " + (context.grafana.data.series ? context.grafana.data.series.length : "0");
  payload.error = e.message;
}

return payload;
