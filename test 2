// 1. E-Mail aus dem Formularfeld auslesen
// Ersetze 'email' durch die ID, die du deinem E-Mail-Feld gegeben hast
const email = elements.find(el => el.id === 'email')?.value;

// 2. Werte aus allen 4 Queries (A, B, C, D) extrahieren
// Wir suchen in data.series nach der jeweiligen refId
const valA = data.series.find(s => s.refId === 'A')?.fields.find(f => f.type === 'number')?.values.get(0);
const valB = data.series.find(s => s.refId === 'B')?.fields.find(f => f.type === 'number')?.values.get(0);
const valC = data.series.find(s => s.refId === 'C')?.fields.find(f => f.type === 'number')?.values.get(0);
const valD = data.series.find(s => s.refId === 'D')?.fields.find(f => f.type === 'number')?.values.get(0);

// 3. Payload für die API vorbereiten
const payload = {
  email: email,
  data: {
    hauptzahler_verbrauch: valA,
    erzeugte_energie: valB,
    query_c: valC, // Benenne diese Felder so, wie deine API sie erwartet
    query_d: valD
  },
  sentAt: new Date().toISOString()
};

// 4. Daten an deine API senden
fetch('https://deine-api-url.de/endpoint', {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
  },
  body: JSON.stringify(payload),
})
.then(response => {
  if (response.ok) {
    notifySuccess(['Erfolgreich', `Daten an ${email} gesendet.`]);
  } else {
    notifyError(['Fehler', 'Server antwortete mit ' + response.status]);
  }
})
.catch(err => {
  notifyError(['Netzwerkfehler', err.toString()]);
});
