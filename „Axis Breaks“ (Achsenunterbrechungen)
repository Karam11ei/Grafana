// Volkov Labs nutzt 'context' statt 'data' direkt im Scope
const data = context.panel.data;

if (!data || !data.series || data.series.length === 0) {
  return {}; // Beendet die Ausführung, wenn noch keine Daten da sind
}

// 1. Achsenunterbrechungen definieren
var _currentAxisBreaks = [
  { start: 500, end: 5000, gap: '2%' },
  { start: 10000, end: 100000, gap: '2%' }
];

// 2. Daten aus Grafana-Series extrahieren
const series = data.series.map(s => {
  const valueField = s.fields.find(f => f.type === 'number');
  return {
    name: s.name || s.refId,
    type: 'bar',
    stack: 'total', 
    emphasis: { focus: 'series' },
    data: valueField ? valueField.values : []
  };
});

// Zeitachse (X-Achse) extrahieren
const timeField = data.series[0].fields.find(f => f.type === 'time');
const formattedTime = timeField 
  ? timeField.values.map(t => new Date(t).toLocaleString()) 
  : [];

// 3. Finale Option zurückgeben
return {
  backgroundColor: 'transparent',
  tooltip: {
    trigger: 'axis',
    axisPointer: { type: 'shadow' }
  },
  legend: {
    bottom: '0',
    textStyle: { color: '#ccc' }
  },
  grid: {
    top: '10%',
    bottom: '15%',
    left: '5%',
    right: '5%',
    containLabel: true
  },
  xAxis: {
    type: 'category',
    data: formattedTime,
    axisLabel: { color: '#ccc' }
  },
  yAxis: {
    type: 'value',
    axisLabel: { color: '#ccc' },
    breaks: _currentAxisBreaks,
    breakArea: {
      itemStyle: {
        opacity: 0.2,
        color: '#ff0000'
      }
    }
  },
  series: series
};
